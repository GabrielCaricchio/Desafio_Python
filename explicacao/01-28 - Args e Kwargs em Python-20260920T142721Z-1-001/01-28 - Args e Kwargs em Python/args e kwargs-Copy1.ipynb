    "def calcular_imposto(valor):\n",
    "    ir = valor * 0.275\n",
    "    iss = valor * 0.05\n",
    "    csll = valor * 0.0375\n",
    "    pis = valor * 0.03\n",
    "    return ir + iss + csll + pis\n",
    "\n",
    "print(calcular_imposto(1000))"
   ]
  }
